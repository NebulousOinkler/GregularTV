// gregular.tv on Cloudflare Workers, as static files only: no server code
// runs, and nothing but these files is served (WEB_PLAN.md, *Hosting*).
// Deployed by .github/workflows/web.yml from Web/dist (scripts/build-web.sh).
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "gregular-tv",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // The app is one page: an unknown address shows it rather than an error.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  // No request logs or traces are kept by the Worker.
  "observability": { "enabled": false },
  // Served at gregular.tv only: this file, not the dashboard, says where.
  // No workers.dev address and no preview URLs, so there's one copy of the
  // site, at one origin (with its own storage), and no old version stays up.
  // www.gregular.tv redirects to gregular.tv (a rule in Cloudflare, WEB_PLAN.md).
  "routes": [
    { "pattern": "gregular.tv", "custom_domain": true },
    { "pattern": "www.gregular.tv", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
